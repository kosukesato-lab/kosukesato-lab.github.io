{
  "name": "sato-laboratory-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14.1 <25"
  },
  "scripts": {
    "dev": "node scripts/astro.mjs dev --host 127.0.0.1",
    "check": "node scripts/astro.mjs check && node scripts/validate.mjs",
    "build": "node scripts/validate.mjs && node scripts/astro.mjs build && node scripts/check-links.mjs && node scripts/resource-budget.mjs",
    "preview": "node scripts/astro.mjs preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "test:production": "node scripts/validate.mjs",
    "verify": "npm run check && npm test && npm run build"
  },
  "dependencies": {
    "astro": "7.4.2",
    "gray-matter": "4.0.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@playwright/test": "1.64.1",
    "cheerio": "1.2.0",
    "lighthouse": "13.5.0",
    "typescript": "5.9.3"
  }
}
