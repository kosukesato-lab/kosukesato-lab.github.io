---
import Layout from '../../../layouts/Layout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import Placeholder from '../../../components/Placeholder.astro';
import PublicationList from '../../../components/PublicationList.astro';
import {research,type Entry} from '../../../lib/content';
import {publications} from '../../../lib/data';
import {ui,type Lang} from '../../../i18n/ui';
import {pathFor} from '../../../../config.mjs';
import type {MarkdownInstance} from 'astro';
export function getStaticPaths(){return research.map(entry=>({params:{lang:entry.frontmatter.lang,slug:entry.frontmatter.slug},props:{entry}}));}
interface Props {entry:MarkdownInstance<Entry>;}
const {entry}=Astro.props;const data=entry.frontmatter,lang=data.lang as Lang,t=ui[lang];const Content=entry.Content;
const other=lang==='ja'?'en':'ja';
const counterpart=research.find(r=>r.frontmatter.translationKey===data.translationKey&&r.frontmatter.lang===other);
---
<Layout lang={lang} title={data.title} description={data.summary} page="research" route={`${lang}/research/${data.slug}`} counterpart={counterpart?`${other}/research/${counterpart.frontmatter.slug}`:`${other}/research`}>
<PageHeader lang={lang} title={data.title} english={`RESEARCH ${String(data.order).padStart(2,'0')}`} parent={{title:t.research,path:`${lang}/research`}}/>
<article class="wrap page-content"><div class="reading"><p class="lead">{data.summary}</p>{!counterpart&&<p class="page-note">{t.missingTranslation}</p>}<div class="prose"><Content/></div><figure class="research-figure">{data.image?<a href={pathFor(data.image)} aria-label={t.figureFullSize}><Placeholder lang={lang} image={data.image} alt={data.imageAlt||data.caption||data.title} width={data.imageWidth} height={data.imageHeight}/></a>:<Placeholder lang={lang}/>}<figcaption>{data.caption||t.figureNote}</figcaption>{data.image&&<a class="text-link" href={pathFor(data.image)}>{t.figureFullSize} ↗</a>}</figure></div><section class="related-section"><h2>{t.related}</h2><PublicationList lang={lang} items={publications.filter(p=>data.publicationIds.includes(p.id))}/></section><div class="detail-bottom"><a class="text-link" href={pathFor(`${lang}/research`)}>← {t.research}</a><a class="button" href={pathFor(`${lang}/contact`)}>{t.contactCta} ↗</a></div><p class="updated-note">{t.updated}: <time datetime={data.updatedAt}>{data.updatedAt}</time></p></article>
</Layout>
