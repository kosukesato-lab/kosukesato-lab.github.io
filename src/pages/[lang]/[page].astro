---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ThemeCards from '../../components/ThemeCards.astro';
import NewsList from '../../components/NewsList.astro';
import PublicationList from '../../components/PublicationList.astro';
import Placeholder from '../../components/Placeholder.astro';
import {site,profiles,members,publications,activities} from '../../lib/data';
import {languages,ui,label,dateLabel,pageKeys,type Lang,type PageKey} from '../../i18n/ui';
import {pathFor} from '../../../config.mjs';
export function getStaticPaths(){return languages.flatMap(lang=>pageKeys.filter(k=>k!=='home').map(page=>({params:{lang,page}})));}
const lang=Astro.params.lang as Lang,page=Astro.params.page as PageKey,t=ui[lang];
const person=profiles.find(p=>p.id==='pi');
const groups=['faculty','staff','doctoral','masters','undergraduate','alumni'];
---
<Layout lang={lang} title={t[page]} page={page}>
<PageHeader lang={lang} title={t[page]} english={ui.en[page].toUpperCase()}/>
<div class="wrap page-content">
{page==='research'&&<><div class="reading intro"><h2>{t.overview}</h2><p>{site.overview[lang]}</p><ul class="keyword-list">{site.keywords[lang].map(k=><li>{k}</li>)}</ul></div><ThemeCards lang={lang}/></>}
{page==='profile'&&person&&<><section class="profile-intro"><div class="profile-photo"><Placeholder lang={lang} kind="photo" image={person.photo} alt={person.name[lang]}/></div><div><p class="eyebrow">PRINCIPAL INVESTIGATOR</p><h2 class="person-name">{person.name[lang]}</h2><p class="profile-role">{person.role[lang]} / {person.degree[lang]}</p><p>{person.affiliation[lang]}</p><h3>{t.keywords}</h3><ul class="keyword-list">{person.keywords[lang].map(k=><li>{k}</li>)}</ul><p>{person.introduction[lang]}</p>{person.externalProfiles.length>0&&<><h3>{t.external}</h3><ul class="plain-list">{person.externalProfiles.map(link=><li><a href={link.url}>{link.label[lang]} ↗</a></li>)}</ul></>}</div></section><div class="profile-details">{(['career','education'] as const).map(key=><section><h2>{t[key]}</h2><ol class="timeline">{person[key].map(h=><li><div class="timeline-date"><time>{h.start}</time> — <time>{h.end||t.now}</time></div><p>{h.label[lang]}</p></li>)}</ol></section>)}{(['awards','societies','service'] as const).map(key=><section><h2>{t[key]}</h2><ul class="plain-list">{person[key].map(item=><li>{item[lang]}</li>)}</ul></section>)}</div></>}
{page==='members'&&<><p class="page-note">{t.fiscalYear}: {site.fiscalYear}</p>{groups.filter(g=>members.some(m=>m.group===g)).map(group=><section class="member-group"><h2>{label(lang,group)}</h2>{group==='alumni'?[...new Set(members.filter(m=>m.group===group).map(m=>m.graduationYear))].sort((a,b)=>(b||0)-(a||0)).map(year=><><h3>{year} {t.graduated}</h3><ul class="plain-list">{members.filter(m=>m.group===group&&m.graduationYear===year).map(m=><li>{m.name[lang]} {m.isPlaceholder&&<span class="sample-badge">{t.sample}</span>}</li>)}</ul></>):<div class="member-grid">{members.filter(m=>m.group===group).sort((a,b)=>a.order-b.order).map(m=><article class="member-card"><Placeholder lang={lang} kind="photo" image={m.photo} alt={m.name[lang]}/><div><p class="eyebrow">{m.role[lang]}</p><h3>{m.name[lang]}</h3>{m.isPlaceholder&&<span class="sample-badge">{t.sample}</span>}{m.id==='pi'&&<a class="text-link" href={pathFor(`${lang}/profile`)}>{t.profile} ↗</a>}{m.themeIds.map(id=><a class="member-theme" href={pathFor(`${lang}/research/${id}`)}>{t.theme} {id.slice(-2)} →</a>)}{m.url&&<a href={m.url}>{t.external} ↗</a>}</div></article>)}</div>}</section>)}<a class="text-link" href={pathFor(`${lang}/contact`)}>{t.contactCta} →</a></>}
{page==='publications'&&<><div class="publication-filters" data-filters hidden><div class="search-field"><label for="pub-search">{t.search}</label><input type="search" id="pub-search" placeholder={t.search}/></div><div><label for="pub-year">{t.year}</label><select id="pub-year"><option value="">{t.all}</option>{[...new Set(publications.map(p=>p.year))].map(y=><option value={y}>{y}</option>)}</select></div><div><label for="pub-type">{t.type}</label><select id="pub-type"><option value="">{t.all}</option>{['article','review','patent','book'].map(k=><option value={k}>{label(lang,k)}</option>)}</select></div><button class="reset-button" type="button" data-reset>{t.reset}</button></div><div class="publication-summary"><p data-result aria-live="polite" aria-atomic="true"><span data-count>{publications.length}</span> {t.results}</p><p>{t.searchHint}</p></div><p class="publication-legend">{t.legend}</p><PublicationList lang={lang} items={publications} filterable/></>}
{page==='news'&&<NewsList lang={lang} grouped/>}
{page==='activities'&&['press','award'].map(type=><section class="activities-section"><h2>{label(lang,type)}</h2>{[...new Set(activities.filter(a=>a.type===type).map(a=>a.date.slice(0,4)))].map(year=><section><h3 class="year-heading">{year}</h3><ul class="activity-list">{activities.filter(a=>a.type===type&&a.date.startsWith(year)).map(a=><li id={a.id}><time datetime={a.date}>{dateLabel(a.date,lang)}</time><div><h4>{a.title[lang]}</h4>{a.isPlaceholder&&<span class="sample-badge">{t.sample}</span>}{type==='press'?<p>{a.media[lang]}</p>:<dl><dt>{t.recipient}</dt><dd>{a.recipient[lang]}</dd><dt>{t.organization}</dt><dd>{a.organization[lang]}</dd><dt>{t.target}</dt><dd>{a.research[lang]}</dd></dl>}{a.url&&<a href={a.url}>{t.readMore} ↗</a>}</div></li>)}</ul></section>)}</section>)}
{page==='join'&&<div class="reading"><section><p class="eyebrow">JOIN OUR LAB</p><h2>{t.philosophy}</h2><div class="philosophy-text">{site.philosophy[lang].split(/\r?\n/).map(s=>s.trim()).filter(Boolean).map(s=>/^\(/.test(s)||/^\[/.test(s)?<h3>{s.replace(/^[\[(]|[\])]$/g,'')}</h3>:<p>{s}</p>)}</div></section><section><h2>{t.audience}</h2><p>{t.audienceText}</p>{site.admissionsUrl&&<a href={site.admissionsUrl}>{t.admissions} ↗</a>}</section><section><h2>{t.environment}</h2><p>{site.environment[lang]}</p></section><section><h2>{t.flow}</h2><ol class="visit-steps">{t.steps.map((step,i)=><li><span>{String(i+1).padStart(2,'0')}</span>{step}</li>)}</ol></section><section><h2>{t.faq}</h2>{site.faq.map(f=><details><summary>{f.question[lang]}</summary><p>{f.answer[lang]}</p></details>)}</section><a class="button" href={pathFor(`${lang}/contact`)}>{t.contactCta} →</a></div>}
{page==='contact'&&<div class="contact-grid"><section><p class="eyebrow">CONTACT</p><h2>{site.name[lang]}</h2><p>{site.institution[lang]}<br/>{site.department[lang]}</p><dl class="contact-details"><dt>{t.address}</dt><dd>{site.address[lang]}</dd><dt>{t.email}</dt><dd>{site.email?<a href={`mailto:${site.email}`}>{site.email}</a>:t.pending}</dd><dt>{t.phone}</dt><dd>{site.phone?<a href={`tel:${site.phone}`}>{site.phone}</a>:t.pending}</dd></dl><p class="page-note">{t.contactNote}</p></section><section class="access-panel"><p class="eyebrow">ACCESS</p><h2>{t.transport}</h2><div class="access-mark" aria-hidden="true">UEC<span>TOKYO / CHOFU</span></div><p>{site.transport[lang]}</p><a class="button" href={site.mapUrl}>{t.map} ↗</a></section></div>}
</div>
{page==='publications'&&<script>
import {filterPublications} from '../../scripts/publications';
filterPublications();
</script>}
</Layout>
