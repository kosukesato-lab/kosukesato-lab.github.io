---
import Layout from '../../layouts/Layout.astro';
import ThemeCards from '../../components/ThemeCards.astro';
import NewsList from '../../components/NewsList.astro';
import PublicationList from '../../components/PublicationList.astro';
import {site,featured} from '../../lib/data';
import {languages,ui,type Lang} from '../../i18n/ui';
import {pathFor} from '../../../config.mjs';
export function getStaticPaths(){return languages.map(lang=>({params:{lang}}));}
const lang=Astro.params.lang as Lang;
const t=ui[lang];
---
<Layout lang={lang} title={t.home}>
<section class="hero"><div class="wrap hero-inner"><div class="hero-copy"><p class="eyebrow">SATO LABORATORY <span> / </span> UEC TOKYO</p><h1>{site.headline[lang].split('\n').map(line=><span>{line}<br/></span>)}</h1><div class="hero-rule"></div><p class="hero-intro">{t.heroIntro}</p><div class="hero-actions"><a class="button" href={pathFor(`${lang}/research`)}>{t.explore}<span aria-hidden="true">→</span></a><a class="text-link" href={pathFor(`${lang}/join`)}>{t.joinCta}<span aria-hidden="true">↗</span></a></div></div><div class="hero-art" aria-hidden="true"><img src={pathFor('assets/abstract.svg')} width="960" height="960" alt="" fetchpriority="high"/><div class="art-caption"><span>DESIGN.</span><span>SYNTHESIZE.</span><span>DISCOVER.</span></div><span class="art-footnote">MOLECULES → MATERIALS → POSSIBILITIES</span></div></div></section>
<section class="wrap section overview-section"><div class="section-title"><p class="eyebrow">ABOUT OUR LAB</p><h2>{t.overview}</h2><span class="section-number" aria-hidden="true">01 /</span></div><div><p class="lead">{site.overview[lang]}</p><ul class="keyword-list">{site.keywords[lang].map(k=><li>{k}</li>)}</ul></div></section>
<section class="news-section"><div class="wrap section"><div class="section-header"><div><p class="eyebrow">NEWS & TOPICS</p><h2>{t.latest}</h2></div><a class="text-link" href={pathFor(`${lang}/news`)}>{t.allNews}<span aria-hidden="true">→</span></a></div><NewsList lang={lang} limit={5}/></div></section>
<section class="wrap section"><div class="section-header"><div><p class="eyebrow">RESEARCH</p><h2>{t.researchHeading}</h2></div><a class="text-link" href={pathFor(`${lang}/research`)}>{t.allResearch}<span aria-hidden="true">→</span></a></div><ThemeCards lang={lang}/></section>
<section class="wrap section selected-section"><div class="section-header"><div><p class="eyebrow">SELECTED PUBLICATIONS</p><h2>{t.selected}</h2></div><a class="text-link" href={pathFor(`${lang}/publications`)}>{t.allPubs}<span aria-hidden="true">→</span></a></div><PublicationList lang={lang} items={featured}/></section>
<section class="join-banner"><div class="wrap"><div><p class="eyebrow">JOIN OUR LAB</p><h2>{t.welcome}</h2><p>{t.welcomeText}</p></div><a class="button button-light" href={pathFor(`${lang}/contact`)}>{t.contactCta}<span aria-hidden="true">↗</span></a></div></section>
</Layout>
