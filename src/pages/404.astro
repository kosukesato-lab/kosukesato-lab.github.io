---
import Layout from '../layouts/Layout.astro';
import {pathFor} from '../../config.mjs';
---
<Layout lang="ja" title="ページが見つかりません / Page not found" noindex route="404.html" counterpart="404.html"><div class="wrap error-page"><p class="eyebrow">ERROR 404</p><h1>ページが見つかりません</h1><p lang="en">Page not found. Please check the URL or return to a homepage.</p><p>URLをご確認いただくか、言語別ホームからお探しください。</p><div class="hero-actions"><a class="button" href={pathFor('ja')}>日本語ホーム →</a><a class="button button-outline" href={pathFor('en')} lang="en">English home →</a></div><a class="text-link" href={pathFor('')}>言語選択 / Language selection →</a></div></Layout>
