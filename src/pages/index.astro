---
import '../styles/global.css';
import {site} from '../lib/data';
import {pathFor,absolute,mode} from '../../config.mjs';
---
<!doctype html><html lang="ja"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{site.name.ja} | 日本語 / English</title><meta name="description" content={`${site.name.ja} — 言語を選択 / Choose your language`}/><meta name="robots" content={mode==='demo'?'noindex, follow':'index, follow'}/><link rel="canonical" href={absolute()}/><link rel="alternate" hreflang="ja" href={absolute('ja')}/><link rel="alternate" hreflang="en" href={absolute('en')}/><link rel="alternate" hreflang="x-default" href={absolute()}/><link rel="icon" href={pathFor('favicon.svg')}/><meta property="og:title" content={site.name.ja}/><meta property="og:description" content="日本語 / English"/><meta property="og:type" content="website"/><meta property="og:url" content={absolute()}/><meta property="og:image" content={absolute('assets/abstract.svg')}/></head><body class="language-page"><a class="skip-link" href="#main">本文へ移動 / Skip to content</a><main id="main" class="language-card"><p class="eyebrow">SATO LABORATORY / UEC TOKYO</p><h1>{site.name.ja}</h1><p>{site.institution.ja}<br/>{site.department.ja}</p><div class="language-options"><a class="button" href={pathFor('ja')} lang="ja">日本語 <span>→</span></a><a class="button button-outline" href={pathFor('en')} lang="en">English <span>→</span></a></div><p>言語を選択してください。<br/><span lang="en">Choose your language.</span></p></main><div class="language-art" aria-hidden="true"><img src={pathFor('assets/abstract.svg')} width="960" height="960" alt=""/></div></body></html>
